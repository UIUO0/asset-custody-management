# ==========================================================================
# قالب متغيّرات البيئة — انسخه إلى .env واملأ القيم
#   cp .env.example .env
# القيم المحلية تأتي من مخرجات `supabase start` أو `supabase status -o env`
# ==========================================================================

NODE_ENV="development"
SERVER_URL="https://localhost:3000"

# --- قاعدة البيانات ---
# محليًا: postgresql://postgres:postgres@127.0.0.1:54322/postgres
DATABASE_URL=""
DIRECT_URL=""

# --- Supabase ---
SUPABASE_URL=""
SUPABASE_ANON_PUBLIC=""
SUPABASE_SERVICE_ROLE=""

# --- أسرار (ولّدها بـ: openssl rand -base64 32) ---
SESSION_SECRET=""
INVITE_TOKEN_SECRET=""

# مفتاح تشفير أسرار الإعدادات المركزية (كلمة سر LDAP، سرّ عميل OIDC، مفتاح SAML).
# اختياري: إن تُرك فارغاً يُشتق المفتاح من SESSION_SECRET — وحينها تغيير
# SESSION_SECRET يجعل الأسرار المخزَّنة غير قابلة للفكّ ويلزم إعادة إدخالها.
# اضبطه في الإنتاج. ولّده بـ: openssl rand -hex 32
APP_SECRETS_KEY=""

# --- البريد (محليًا: Mailpit على 127.0.0.1:54325) ---
SMTP_HOST=""
SMTP_PORT=""
SMTP_USER=""
SMTP_PWD=""
SMTP_FROM=""

# --- الخرائط (مطلوب؛ https://www.maptiler.com) ---
MAPTILER_TOKEN=""

# --- إعدادات الهيئة ---
DISABLE_SIGNUP="true"
DISABLE_SSO="true"
ENABLE_PREMIUM_FEATURES="false"
SEND_ONBOARDING_EMAIL="false"
SHOW_HOW_DID_YOU_FIND_US="false"
GEOCODING_USER_AGENT="EPDA Asset Management System"
ADMIN_EMAIL="admin@epda.local"
