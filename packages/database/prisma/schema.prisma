datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["fullTextSearchPostgres"]
}

model Image {
  id String @id @default(cuid())

  contentType String
  altText     String?
  blob        Bytes

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  location     Location?
  organization Organization? @relation("orgImage")

  ownerOrg   Organization @relation("owner", fields: [ownerOrgId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  ownerOrgId String

  user   User   @relation(fields: [userId], references: [id], onUpdate: Cascade)
  userId String

  // Indexes for foreign keys
  @@index([ownerOrgId])
  @@index([userId])
}

model User {
  id                    String  @id @default(cuid())
  email                 String  @unique
  username              String  @unique @default(cuid())
  firstName             String?
  lastName              String?
  displayName           String?
  profilePicture        String?
  usedFreeTrial         Boolean @default(false)
  onboarded             Boolean @default(false)
  customerId            String? @unique // Stripe customer id
  sso                   Boolean @default(false)
  createdWithInvite     Boolean @default(false) // Set to true if the user was created by being invited to a workspace
  skipSubscriptionCheck Boolean @default(false) // Set to true if the user has opted out of subscription checks
  hasUnpaidInvoice     Boolean @default(false) // Set via Stripe webhooks when invoice payment fails
  warnForNoPaymentMethod Boolean @default(false) // Set when subscription is transferred to a user without a payment method

  // Last selected organization for cross-device workspace persistence
  lastSelectedOrganization   Organization? @relation("lastSelectedOrg", fields: [lastSelectedOrganizationId], references: [id], onDelete: SetNull)
  lastSelectedOrganizationId String?

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Used to flag if the user is soft deleted
  deletedAt DateTime?

  // Last time this user used the mobile companion app (any workspace). Powers
  // companion-app adoption metrics from our own DB — no external analytics.
  // Recorded debounced + fire-and-forget by requireMobileAuth, the chokepoint
  // every mobile API route passes through. Account-level adoption = orgs with a
  // recently-active member (join via UserOrganization). Null until first use.
  lastMobileActiveAt DateTime?

  // Relationships
  assets             Asset[]
  categories         Category[]
  notes              Note[]
  auditNotes        AuditNote[]        @relation("AuditNoteUser")
  locationNotes     LocationNote[]     @relation("LocationNoteUser")
  qrCodes            Qr[]
  scans              Scan[]
  roles              Role[]
  locations          Location[]
  images             Image[]
  organizations      Organization[]
  customFields       CustomField[]
  sentInvites        Invite[]           @relation("inviter")
  receivedInvites    Invite[]           @relation("invitee")
  teamMembers        TeamMember[]
  /// EPDA: handover records this user opened as the warehouse operator.
  custodyHandoversOperated  CustodyHandover[]          @relation("CustodyHandoverOperator")
  /// EPDA: handover signatures this user put their name to, on either side.
  custodyHandoverSignatures CustodyHandoverSignature[] @relation("CustodyHandoverSignatory")
  userOrganizations  UserOrganization[]
  /// EPDA: booking requests this user accepted or rejected (المستودعات)
  /// EPDA: booking requests this user put on review hold (المخزون)
  /// EPDA: instance settings this user last wrote (app-wide admins only)
  appSettingUpdates  AppSetting[]       @relation("appSettingUpdatedBy")
  /// EPDA: external-integration API keys this user issued
  issuedApiKeys      ApiKey[]           @relation("apiKeyCreatedBy")
  /// EPDA: goods receipts this user filled in (مذكرة/محضر استلام)
  goodsReceipts      GoodsReceipt[]     @relation("goodsReceiptCreatedBy")
  /// EPDA: receipt signatures this user gave
  goodsReceiptSignatures GoodsReceiptSignature[] @relation("goodsReceiptSignatory")
  /// EPDA: assets this user (المالية) entered a finance code for
  assetsFinanceCoded     Asset[]                 @relation("assetFinanceCodedBy")
  tierId             TierId             @default(free)
  tier               Tier               @relation(fields: [tierId], references: [id])
  assetReminders     AssetReminder[]
  contact            UserContact?
  businessIntel      UserBusinessIntel?
  auditsCreated      AuditSession[]
  auditAssignments   AuditAssignment[]
  auditAssetsScanned AuditAsset[]
  auditScans         AuditScan[]
  auditImagesUploaded AuditImage[] @relation("AuditImageUploader")

  // @deprecated - Historical data only. New entries go to UserBusinessIntel table
  referralSource String? // "How did you hear about us?" field.

  // A user can have multiple asset index settings, 1 for each organization
  assetIndexSettings AssetIndexSettings[]

  // Updates feature
  createdUpdates Update[]
  updateReads    UserUpdateRead[]

  // This relationship will be used only when tierId == custom
  customTierLimit CustomTierLimit?

  assetFilterPresets AssetFilterPreset[]
  assetModels        AssetModel[]
  consumptionLogs    ConsumptionLog[]

  // Role change audit log
  roleChangesReceived  RoleChangeLog[] @relation("roleChangeTarget")
  roleChangesPerformed RoleChangeLog[] @relation("roleChangeActor")

  // Admin notes authored on team member profiles
  teamMemberNotesAuthored TeamMemberNote[] @relation("TeamMemberNoteAuthor")

  @@unique([email, username])
  @@index([firstName, lastName])
  // Indexes for foreign keys
  @@index([tierId])
  @@index([lastSelectedOrganizationId])
  // Index for mobile-adoption "active since <date>" range scans
  @@index([lastMobileActiveAt])
}

model UserContact {
  id String @id @default(cuid())

  phone         String?
  street        String?
  city          String?
  stateProvince String?
  zipPostalCode String?
  countryRegion String?

  // Relationships
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for efficient querying
  @@index([userId]) // Foreign key index
  @@index([phone]) // For phone number lookups
  @@index([city, stateProvince]) // For location-based queries
  @@index([countryRegion]) // For country-based filtering
  @@index([zipPostalCode]) // For postal code searches
  @@index([city, countryRegion]) // For city within country queries
}

model UserBusinessIntel {
  id String @id @default(cuid())

  // Business intelligence fields collected during onboarding
  // Note: User.referralSource is deprecated and kept for historical data
  howDidYouHearAboutUs String? // "How did you hear about us?" - new entries go here
  jobTitle             String? // User's role
  teamSize             String? // Number of people using Shelf
  companyName          String? // Company or organization name
  primaryUseCase       String? // What they'll primarily track
  currentSolution      String? // How they currently track assets
  timeline             String? // When they need Shelf working

  // Relationships
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String @unique

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for efficient querying
  @@index([userId]) // Foreign key index
  @@index([companyName]) // For company-based analytics
  @@index([jobTitle]) // For role-based analytics
  @@index([teamSize]) // For team size analytics
}

model Asset {
  id                  String      @id @default(cuid())
  title               String
  description         String?
  mainImage           String?
  thumbnailImage      String?
  mainImageExpiration DateTime?
  status              AssetStatus @default(AVAILABLE)
  /// Where the asset sits in the EPDA intake workflow. Deliberately separate
  /// from `status`, which is derived from custody/bookings and must not be
  /// overloaded with intake meaning.
  lifecycleStage      AssetLifecycleStage @default(PENDING)
  valuation           Float?      @map("value") // Field to store the monetary value of an asset
  availableToBook     Boolean     @default(true)
  sequentialId        String? // Sequential identifier for the asset (e.g., "SAM-0001")

  // Tracking method & model
  type            AssetType        @default(INDIVIDUAL)
  assetModelId    String?
  assetModel      AssetModel?      @relation(fields: [assetModelId], references: [id])

  // Quantity-tracked fields (null for INDIVIDUAL assets)
  quantity        Int? // Total quantity at this location
  minQuantity     Int? // Low-stock alert threshold
  consumptionType ConsumptionType? // How consumption is tracked
  unitOfMeasure   String? // e.g., "pcs", "boxes", "liters"

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String
  category       Category?    @relation(fields: [categoryId], references: [id])
  categoryId     String?
  // No `Asset.location` / `locationId` FK — location lives on the
  // `AssetLocation` pivot (see `assetLocations` below). QUANTITY_TRACKED
  // assets can be placed at multiple locations at distinct slices;
  // INDIVIDUAL assets are capped at one row via the
  // `enforce_individual_asset_single_location` trigger.

  custody      Custody[]
  /// EPDA: lines on signed تسليم/استرجاع records. Survive custody being
  /// released — the audit trail is the point.
  custodyHandovers CustodyHandoverAsset[]
  notes        Note[]
  qrCodes      Qr[]
  barcodes     Barcode[]              @relation("AssetBarcodes")
  reports      ReportFound[]
  customFields AssetCustomFieldValue[]
  consumptionLogs ConsumptionLog[]
  reminders       AssetReminder[]
  auditEntries    AuditAsset[]
  auditScans      AuditScan[]
  assetLocations AssetLocation[]

  /// EPDA: the receipt line that admitted this item, if any.
  ///
  /// Nullable and `SetNull` on delete: items created before the receipt flow
  /// existed have no line, and voiding a receipt must not delete stock that
  /// physically sits on a shelf. The link is what lets an auditor go from an
  /// item back to the signed document — and the supplier, purchase order and
  /// price that came with it.
  receiptLine   GoodsReceiptLine? @relation(fields: [receiptLineId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  receiptLineId String?

  /// EPDA: أصل / مادة. Null until the classification rules land — see
  /// `enum ItemClass`. Mirrored from the receipt line at creation so the
  /// classification survives the line being edited.
  itemClass ItemClass?

  /// EPDA: نوع الصنف, mirrored from the receipt line for the same reason as
  /// `itemClass` — the classification must stay readable on the item even if
  /// the line is later corrected.
  itemCategory ItemCategory?

  /// EPDA: رقم الترميز — the finance coding number.
  ///
  /// Entered by المالية after the item is classified as a أصل; مواد are
  /// expensed and never coded. Free text with no uniqueness constraint: the
  /// approved decision (2026-07-27) is that the coding format is entirely the
  /// finance department's, with no validation and no system-wide uniqueness.
  ///
  /// Nullable and stays null for every مادة — "not yet coded" and "never needs
  /// a code" are told apart by `itemClass`, not by this column.
  financeCode String?

  /// When the code was entered, and by whom. Kept because coding is the one
  /// finance action on an item and an auditor will ask who performed it.
  financeCodedAt DateTime? @db.Timestamptz(3)

  financeCodedBy   User?   @relation("assetFinanceCodedBy", fields: [financeCodedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  financeCodedById String?

  // Per-asset override: when an org has multiple linked Barcodes (only possible
  // with the barcode add-on), this picks the specific Barcode to display in
  // list views. Null = use the workspace `qrIdDisplayPreference` default.
  // @unique enforces 1:1 so the Prisma back-relation is `Asset?`, not `Asset[]`.
  //
  // Ownership invariant: the referenced Barcode MUST belong to THIS asset and
  // THIS organization. Enforced at the DB layer by a deferrable CONSTRAINT
  // TRIGGER (see the `add_preferred_barcode_integrity_trigger` migration).
  // Application code in `updateAsset` also pre-flights the same check to
  // surface a clean 400 instead of a constraint violation at the FE.
  preferredBarcodeId String?  @unique
  preferredBarcode   Barcode? @relation("AssetPreferredBarcode", fields: [preferredBarcodeId], references: [id], onDelete: SetNull)

  // Unique constraint for organization-scoped sequential IDs
  @@unique([organizationId, sequentialId], name: "asset_org_sequential_unique")
  // Special GIN index for optimization of simple search queries
  @@index([title(ops: raw("gin_trgm_ops")), description(ops: raw("gin_trgm_ops"))], type: Gin)
  // Trigram index for substring search on sequentialId (e.g. "21035" → "SAM-21035")
  @@index([sequentialId(ops: raw("gin_trgm_ops"))], type: Gin, name: "Asset_sequentialId_trgm_idx")
  // Indexes for optimization of queries
  @@index([organizationId, title, status, availableToBook], name: "Asset_organizationId_compound_idx")
  @@index([status, organizationId], name: "Asset_status_organizationId_idx")
  @@index([createdAt, organizationId], name: "Asset_createdAt_organizationId_idx")
  // Serves the advanced index's default view: WHERE organizationId = ?
  // ORDER BY createdAt DESC, id ASC LIMIT n. Column order (org first, then
  // createdAt DESC, then id) lets Postgres seek the org and read the page
  // straight off the index — no full scan + sort of the workspace. The
  // reversed-order index above (createdAt, organizationId) can't early-terminate
  // this query.
  @@index([organizationId, createdAt(sort: Desc), id], name: "Asset_organizationId_createdAt_id_idx")
  @@index([valuation, organizationId], name: "Asset_valuation_organizationId_idx")
  @@index([categoryId, organizationId], name: "Asset_categoryId_organizationId_idx")
  @@index([assetModelId, organizationId], name: "Asset_assetModelId_organizationId_idx")
  @@index([sequentialId], name: "Asset_sequentialId_idx")
  // Declared here rather than only in the migration that created them. An index
  // that exists in the database but not in this schema reads to Prisma as drift,
  // and it emits a `DROP INDEX` for it into the NEXT migration on any table —
  // silently, in a diff about something else entirely. Both of these were about
  // to be dropped that way on 2026-08-06.
  @@index([receiptLineId], name: "Asset_receiptLineId_idx")
  @@index([financeCodedById], name: "Asset_financeCodedById_idx")
  // Index for foreign key
  @@index([userId])
}

enum AssetStatus {
  AVAILABLE
  IN_CUSTODY
  CHECKED_OUT
}

/// Intake workflow stage for the EPDA deployment.
///
/// Separate from `AssetStatus` on purpose: `status` is *derived* from custody
/// and bookings (the system computes it), whereas this is *declared* by the
/// warehouse. Folding the two together would let an asset be marked
/// "available" while it is physically in someone's custody.
///
/// Flow: المستودعات registers the asset (PENDING) → المالية adds financial
/// coding and depreciation → المستودعات audits and approves (READY). Only READY
/// assets are visible to, and requestable by, ordinary employees.
///
/// @see {@link file://./../../../apps/docs/epda-workflow-and-roles.md}
enum AssetLifecycleStage {
  /// قيد الانتظار — registered, awaiting finance coding and warehouse sign-off.
  PENDING
  /// جاهز للتوزيع — approved by the warehouse; visible to employees.
  READY
}

/** Determines how an asset is tracked throughout the system. Immutable after creation. */
enum AssetType {
  INDIVIDUAL // Default. One row = one physical item.
  QUANTITY_TRACKED // One row = N fungible items at a location.
}

/** Controls what happens after checkout for quantity-tracked assets. */
enum ConsumptionType {
  ONE_WAY // Checked out and consumed. No return expected.
  TWO_WAY // Checked out and returned, with consumption report.
}

/** Classifies the type of quantity change in a ConsumptionLog entry. */
enum ConsumptionCategory {
  CHECKOUT // Items checked out to a custodian or booking
  RETURN // Items returned from a custodian or booking
  RESTOCK // New stock added (shipment arrived, manual increase)
  ADJUSTMENT // Manual correction (inventory count, error fix)
  LOSS // Items reported lost or missing (will not be returned)
  CONSUME // Items used as intended (ONE_WAY consumables — e.g. AA batteries, latex gloves)
  DAMAGE // Items returned but unusable — distinct from LOSS for reporting
}

model AssetFilterPreset {
  id             String   @id @default(cuid())
  organizationId String
  ownerId        String
  name           String
  query          String
  starred        Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  owner        User         @relation(fields: [ownerId], references: [id], onDelete: Cascade)

  @@unique([organizationId, ownerId, name], map: "asset_filter_presets_owner_name_unique")
  @@index([organizationId, ownerId], map: "asset_filter_presets_owner_lookup_idx")
}

model AssetIndexSettings {
  id String @id @default(cuid())

  // Relationships
  // This is the user who's settings we are storing
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  // This is the organizationId for which the user is setting the index settings
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)

  // Settings fields
  mode AssetIndexMode @default(SIMPLE)

  // Holds the columns that are visible in the index view in json format
  // Format is {name: string, visible: boolean, position: number}[] where name is the name of the column, visible is whether the column is visible or not and position is the position of the column
  // The shape of the JSON includes both some fixed entries that will always be present and some dynamic entries for the custom fields
  // The fixed entries are: id, status, description, valuation, createdAt, category, tags, location, kit, custody
  columns Json @default("[ {\"name\": \"id\", \"visible\": true, \"position\": 0}, {\"name\": \"status\", \"visible\": true, \"position\": 1}, {\"name\": \"description\", \"visible\": true, \"position\": 2}, {\"name\": \"valuation\", \"visible\": true, \"position\": 3}, {\"name\": \"createdAt\", \"visible\": true, \"position\": 4}, {\"name\": \"category\", \"visible\": true, \"position\": 5}, {\"name\": \"tags\", \"visible\": true, \"position\": 6}, {\"name\": \"location\", \"visible\": true, \"position\": 7}, {\"name\": \"kit\", \"visible\": true, \"position\": 8}, {\"name\": \"custody\", \"visible\": true, \"position\": 9} ]")

  freezeColumn   Boolean @default(true)
  showAssetImage Boolean @default(true)

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, organizationId])
  // Index for foreign key
  @@index([organizationId])
}

enum AssetIndexMode {
  SIMPLE
  ADVANCED
}

model Category {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  assets Asset[]
  user   User    @relation(fields: [userId], references: [id], onUpdate: Cascade)
  userId String

  customFields       CustomField[]
  assetModelDefaults AssetModel[] // Asset models that use this category as their default

  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String

  //@@unique([lower(name), organizationId]) //prisma doesnt support case insensitive unique index yet
  // Indexes for foreign keys
  @@index([organizationId])
  @@index([userId])
  // Trigram index for substring search from the asset-list search bar
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "Category_name_trgm_idx")
}

/**
 * A template/grouping entity for assets.
 * Groups individual assets of the same type (e.g., "Dell Latitude 5550")
 * and provides default field values when creating new assets from the model.
 */
model AssetModel {
  id              String    @id @default(cuid())
  name            String
  description     String?
  image           String?
  imageExpiration DateTime?

  // Template defaults (applied when creating a new asset from this model)
  defaultCategoryId String?
  defaultCategory   Category? @relation(fields: [defaultCategoryId], references: [id])
  defaultValuation  Float?

  // Relationships
  assets         Asset[]
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String
  createdBy      User         @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId         String

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, name])
  @@index([userId])
}


enum TagUseFor {
  ASSET
  BOOKING
}

model Note {
  id      String   @id @default(cuid())
  content String
  type    NoteType @default(COMMENT)

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user    User?   @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  userId  String?
  asset   Asset   @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String

  // Indexes for foreign keys
  @@index([assetId])
  @@index([userId])
}


model LocationNote {
  id      String   @id @default(cuid())
  content String
  type    NoteType @default(COMMENT)

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user       User?    @relation("LocationNoteUser", fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  userId     String?
  location   Location @relation("LocationNotes", fields: [locationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locationId String

  // Indexes for foreign keys
  @@index([locationId])
  @@index([userId])
}

enum NoteType {
  COMMENT
  UPDATE
}

model Qr {
  id String @id @default(cuid())

  // Version of the QR code based on spec from Denso wave
  version Int @default(0)

  // Error correction level based on spec from Denso wave
  errorCorrection ErrorCorrection @default(L)

  // Relationships
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull)
  assetId String?

  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  userId String?

  organization   Organization? @relation(fields: [organizationId], references: [id], onUpdate: Cascade)
  organizationId String?

  // This batch is used to group QR codes together when they are created as unclaimed and printed
  batch   PrintBatch? @relation(fields: [batchId], references: [id], onDelete: SetNull)
  batchId String?

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  scans     Scan[]

  @@index([assetId], name: "Qr_assetId_idx")
  // Indexes for foreign keys
  @@index([userId])
  @@index([organizationId])
  @@index([batchId])
  // Trigram index for substring search of Qr ids from the asset-list search bar
  @@index([id(ops: raw("gin_trgm_ops"))], type: Gin, name: "Qr_id_trgm_idx")
}

// Barcode model
model Barcode {
  id String @id @default(cuid())

  // The actual barcode value (separate from DB ID)
  value String // e.g., "BC001234", "ASSET-2024-001"

  // Barcode type (matching zxing format names exactly)
  type BarcodeType @default(Code128)

  // Relationships
  asset   Asset?  @relation("AssetBarcodes", fields: [assetId], references: [id], onDelete: SetNull)
  assetId String?

  // Back-relation for Asset.preferredBarcode. Optional because most Barcodes
  // are not chosen as the asset's display-preferred one.
  preferredByAsset Asset? @relation("AssetPreferredBarcode")

  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Organization-scoped uniqueness for barcode values
  @@unique([organizationId, value])
  // Performance indexes for common queries
  @@index([organizationId, value]) // Lightning fast lookup by org + value
  @@index([assetId])
  @@index([organizationId]) // For org-level queries
  // Trigram index for substring search of barcode values from the asset-list search bar
  @@index([value(ops: raw("gin_trgm_ops"))], type: Gin, name: "Barcode_value_trgm_idx")
}

// Barcode types matching zxing format names exactly
enum BarcodeType {
  Code128
  Code39
  DataMatrix
  ExternalQR
  EAN13
}

model PrintBatch {
  id String @id @default(cuid())

  name String @unique

  // This should be set to true, when QR code is exported for print
  printed Boolean @default(false)

  // Relationships
  qrCodes Qr[]

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Stores a report for when a an asset is reported as found
model ReportFound {
  id      String @id @default(cuid())
  email   String
  content String

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String?

  // Indexes for foreign keys
  @@index([assetId])
}

enum ErrorCorrection {
  L
  M
  Q
  H
}

model Scan {
  id String @id @default(cuid())

  latitude  String?
  longitude String?

  userAgent String?

  // When a logged in user scanned the QR code, we store it here
  user   User?   @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId String?

  qr   Qr?     @relation(fields: [qrId], references: [id], onDelete: SetNull)
  qrId String?

  // We also store the qrId as a raw string for reference is fhte qr is deleted
  rawQrId String

  // This will be true if the user manually created the scan by using "Update GPS coordinates"
  manuallyGenerated Boolean @default(false)

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for foreign keys
  @@index([qrId])
  @@index([userId])
  // Serves getScanByQrId (last-scan card on asset overview + kit detail):
  // WHERE rawQrId = ? ORDER BY createdAt DESC LIMIT 1. Scan is a global,
  // append-only table (public QR hits + companion scans, never pruned), so
  // without this index every page view pays a full sequential scan of all
  // tenants' scan history. rawQrId seeks the QR; createdAt lets the top-1
  // sort early-terminate (Postgres walks the btree backwards for DESC).
  @@index([rawQrId, createdAt])
}

model Location {
  id          String  @id @default(cuid())
  name        String
  description String?
  address     String?

  // Cached geocoding coordinates
  latitude  Float?
  longitude Float?

  imageUrl     String?
  thumbnailUrl String?

  image   Image?  @relation(fields: [imageId], references: [id])
  imageId String? @unique

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String

  // Asset placement is via the `AssetLocation` pivot.
  assetLocations AssetLocation[]
  notes          LocationNote[] @relation("LocationNotes")

  // Self-relation for nested locations
  parentId String?
  parent   Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Location[] @relation("LocationHierarchy")

  // @@unique([lower(name), organizationId]) //prisma doesnt support case insensitive unique index yet
  // Indexes for foreign keys
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, parentId])
  // Trigram index for substring search from the asset-list search bar
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin, name: "Location_name_trgm_idx")
  // Same reason as the two on `Asset`: created by a hand-written migration and
  // never declared, so every later migration wanted to drop them.
  @@index([description(ops: raw("gin_trgm_ops"))], type: Gin, name: "Location_description_trgm_idx")
  @@index([address(ops: raw("gin_trgm_ops"))], type: Gin, name: "Location_address_trgm_idx")
}

// Master data for roles
model Role {
  id   String @id @default(cuid())
  name Roles  @unique @default(USER)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users User[]
}

enum Roles {
  USER
  ADMIN
}

model TeamMember {
  id   String @id @default(cuid())
  name String

  organization    Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId  String
  custodies       Custody[]
  /// EPDA: handover records where this member is the employee side.
  custodyHandovers CustodyHandover[]

  /// EPDA: marks this row as an administrative department (إدارة المرافق,
  /// إدارة تقنية المعلومات) rather than an individual person.
  ///
  /// Departments hold custody exactly the way people do — that is why they are
  /// `TeamMember` rows and not a separate table: the warehouse hands a batch to
  /// a department, and the department hands single assets to its staff, both
  /// through the same `CustodyHandover` path. The flag exists only so the UI can
  /// tell "a desk" from "a person" when listing custodians.
  isDepartment Boolean @default(false)

  /// EPDA: workspace memberships whose holder belongs to this department.
  departmentMembers UserOrganization[] @relation("UserOrganizationDepartment")

  receivedInvites Invite[]
  user            User?        @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  userId          String?

  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  deletedAt       DateTime?
  assetReminders  AssetReminder[]
  consumptionLogs ConsumptionLog[]
  teamMemberNotes TeamMemberNote[]

  // Special GIN index for optimization of simple search queries
  @@index([name(ops: raw("gin_trgm_ops"))], type: Gin)
  // Indexes for foreign keys
  @@index([organizationId])
  @@index([userId])
}

model Custody {
  id String @id @default(cuid())

  custodian    TeamMember @relation(fields: [teamMemberId], references: [id])
  teamMemberId String

  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String

  quantity Int @default(1) // How many units in custody (1 for individual assets)

  // DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Custody is operator-assigned only now that kits are gone, so
  // (asset, custodian) is unique outright. It used to be split into two
  // partial uniques — one for operator rows, one for rows inherited from a
  // kit — which the drop migration collapses back into this single unique.
  //
  // `map:` keeps the DB index name the one the code comments and the
  // service-layer guards already refer to. Without it Prisma would rename it
  // to `Custody_assetId_teamMemberId_key` and every reference would go stale.
  @@unique([assetId, teamMemberId], name: "Custody_operator_unique", map: "Custody_operator_unique")
  // Index for foreign key
  @@index([teamMemberId])
}

/// EPDA: whether a handover record covers giving an asset out or taking it back.
///
/// Two rows rather than a boolean because the parties swap roles between them —
/// on `HANDOVER` المستودعات release and the employee receives; on `RETURN` the
/// employee releases and المستودعات receive. Reading the direction off an
/// `isReturn` flag makes every downstream `if` re-derive that mapping.
enum CustodyHandoverKind {
  /// تسليم — المستودعات → الموظف. Signed before `Custody` is created.
  HANDOVER
  /// استرجاع — الموظف → المستودعات. Signed before `Custody` is deleted.
  RETURN
}

/// EPDA: lifecycle of a handover record.
///
/// Deliberately NOT folded into `Custody` itself. A custody row answers "who
/// holds this asset right now"; a handover record answers "what was agreed, by
/// whom, and when". The first is mutable state, the second is an immutable
/// audit artefact that must survive the custody being released.
enum CustodyHandoverState {
  /// Opened, at least one party has not signed yet. Blocks the custody change.
  AWAITING_SIGNATURES
  /// Both parties signed. The custody change may proceed exactly once.
  COMPLETED
  /// Abandoned before completion — kept, not deleted, so an abandoned handover
  /// is still visible in the asset's history.
  VOIDED
}

/// EPDA: which side of a handover a signature belongs to.
///
/// Named by role in the transaction rather than by job title, because the same
/// person can be `RELEASING` on one record and `RECEIVING` on the next.
enum CustodyHandoverParty {
  /// The party giving the asset up.
  RELEASING
  /// The party taking the asset on.
  RECEIVING
}

/// EPDA: signed handover record (محضر تسليم/استلام).
///
/// Created *before* the custody change and gates it: `assignCustody` and
/// `releaseCustody` refuse to run unless a `COMPLETED` record exists for that
/// exact asset and direction. The gate lives in the service layer, not the UI —
/// several entry points (web modal, mobile scanner, a stale open tab) reach the
/// same operation and only the service sees all of them.
///
/// @see {@link file://./../../../apps/webapp/app/modules/custody/handover.server.ts}
/// @see {@link file://./../../../apps/docs/epda-custody-signatures.md}
model CustodyHandover {
  id String @id @default(cuid())

  /// Human-facing reference printed on the محضر, unique per workspace
  /// (e.g. "EPDA-HO-2026-0042"). Stored rather than derived so a reissued PDF
  /// always carries the same number as the one already signed on paper.
  reference String

  kind  CustodyHandoverKind
  state CustodyHandoverState @default(AWAITING_SIGNATURES)

  /// Assets on this محضر, through the `CustodyHandoverAsset` pivot.
  ///
  /// A pivot rather than a single `assetId` because the warehouse hands a whole
  /// purchase order to a department in one batch, and the paper that gets signed
  /// is ONE document listing every line. A single-asset handover is simply a
  /// pivot with one row — there is no second code path, and no second place to
  /// look for "which assets does this محضر cover".
  assets CustodyHandoverAsset[]

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  /// The employee side of the transaction — receiving on `HANDOVER`, releasing
  /// on `RETURN`. Kept as a `TeamMember` (not `User`) because custody itself is
  /// team-member scoped and non-user members must be able to hold assets.
  counterparty   TeamMember @relation(fields: [counterpartyTeamMemberId], references: [id])
  counterpartyTeamMemberId String

  /// The warehouse operator who opened the record. `SetNull` on delete: the
  /// محضر must outlive the staff account that produced it.
  operator   User?   @relation("CustodyHandoverOperator", fields: [operatorUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  operatorUserId String?

  /// Who gave the units up, when this محضر is a **transfer** rather than an
  /// issue from the shelf: إدارة المرافق passing 10 of its pens to an employee.
  ///
  /// Stored rather than derived because the custody change happens at signature
  /// time — possibly days later — and by then the releasing side's stock has
  /// already moved. It is also what the printed محضر needs to say who handed
  /// over. `null` means the units came off the warehouse shelf.
  releasingTeamMemberId String?

  @@index([releasingTeamMemberId])

  /// Free-text condition note captured at handover time ("خدش في الغطاء
  /// الخلفي"). Printed on the محضر so a later dispute has a baseline.
  conditionNotes String?

  /// Why the custodian asked to hand the asset back ("الجهاز يسخن", "انتهى
  /// المشروع"). Deliberately separate from `conditionNotes`: the reason for a
  /// return and the physical state of the thing being returned are different
  /// facts, and a warehouse triaging a queue reads them for different purposes.
  ///
  /// Nullable in the schema because warehouse-initiated handovers have no
  /// requester to give one. Mandatory for employee-initiated returns, enforced
  /// in `openReturnRequest` — same posture as the mandatory rejection reason on
  /// booking requests.
  requestReason String?

  signatures CustodyHandoverSignature[]

  /// Set when the second signature lands. Null while `AWAITING_SIGNATURES`.
  completedAt DateTime?
  /// Reason the record was abandoned. Required by the service when voiding.
  voidedReason String?
  voidedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([organizationId, reference], name: "custody_handover_org_reference_unique")
  @@index([organizationId, createdAt(sort: Desc)], name: "CustodyHandover_org_createdAt_idx")
  @@index([counterpartyTeamMemberId])
  @@index([operatorUserId])
}

/// One asset line on a محضر.
///
/// Carries no state of its own — the signatures, the state machine and the
/// reference all live on `CustodyHandover`, and one signature authorises every
/// line at once. Splitting state per line would mean a محضر could be half
/// applied, which is exactly what a single signed document must not be.
model CustodyHandoverAsset {
  id String @id @default(cuid())

  handover   CustodyHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  handoverId String

  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String

  /// Units this line moves.
  ///
  /// Always 1 for `INDIVIDUAL` assets — one physical thing. For
  /// `QUANTITY_TRACKED` it is the count actually handed over, which is the
  /// whole point: a receipt line of 30 pens is ONE asset with `quantity = 30`,
  /// and the department passes 10 to one employee and 20 to another. Without a
  /// per-line count the محضر could only ever move the entire stock.
  ///
  /// Defaults to 1 so existing rows (all of them single-asset محاضر written
  /// before quantities existed) stay correct without a backfill.
  quantity Int @default(1)

  createdAt DateTime @default(now())

  /// The same asset must not appear twice on one محضر — a duplicated line would
  /// print twice and apply its custody effect twice.
  @@unique([handoverId, assetId], name: "custody_handover_asset_unique")
  // Serves the "is there a completed record I can consume for this asset?"
  // gate, which is on the hot path of every custody change. Replaces the
  // `[assetId, kind, state]` index that lived on `CustodyHandover` while the
  // asset was a column there; `kind` and `state` now come from the join.
  @@index([assetId], name: "CustodyHandoverAsset_asset_idx")
  @@index([handoverId])
}

/// EPDA: one party's signature on a handover record.
///
/// A separate table rather than four columns on `CustodyHandover` so the
/// `@@unique([handoverId, party])` constraint makes "one signature per side"
/// a database invariant instead of an application convention — a double-submit
/// or a replayed request cannot overwrite a signature that already exists.
model CustodyHandoverSignature {
  id String @id @default(cuid())

  handover   CustodyHandover @relation(fields: [handoverId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  handoverId String

  party CustodyHandoverParty

  /// Signing user, when the party has an account. Null for team members
  /// without a user row. `SetNull` — the signature outlives the account.
  signedByUser   User?   @relation("CustodyHandoverSignatory", fields: [signedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  signedByUserId String?

  /// Name as typed by the signatory at signing time. Snapshotted rather than
  /// joined: the محضر must keep reading the name that was agreed to even after
  /// the person renames their profile or leaves the workspace.
  declaredName String

  /// Path of the PNG inside the private `custody-signatures` bucket. Not a
  /// public URL — signature images are personal data and are served through
  /// short-lived signed URLs only.
  signatureImagePath String

  /// Captured for evidentiary value. Nullable because a proxy or a native
  /// client may not supply them, and a missing IP must not block a signature.
  ipAddress String?
  userAgent String?

  signedAt DateTime @default(now())

  @@unique([handoverId, party], name: "custody_handover_signature_party_unique")
  @@index([signedByUserId])
}

model Organization {
  id   String           @id @default(cuid())
  name String           @default("Personal")
  type OrganizationType @default(PERSONAL)

  owner    User     @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId   String
  currency Currency @default(USD)

  members TeamMember[]
  assets  Asset[]
  assetLocations AssetLocation[]
  /// EPDA: signed تسليم/استرجاع records for this workspace. Scoped here so the
  /// `reference` counter and every listing query stay workspace-isolated.
  custodyHandovers CustodyHandover[]

  image   Image?  @relation("orgImage", fields: [imageId], references: [id])
  imageId String? @unique

  // Not required. It will only be created for orgs that need sso
  // We can know if an org has SSO by checking the ssoDetailsId
  enabledSso      Boolean          @default(false) // If true, the organization has enabled SSO. This cannot be changed by the user, just managed by the admin
  ssoDetailsId    String?
  ssoDetails      SsoDetails?      @relation(fields: [ssoDetailsId], references: [id])
  workingHours    WorkingHours?

  // Permissions configuration
  // those values are used to control the access to the custody and bookings by SELF SERVICE and BASE users
  selfServiceCanSeeCustody  Boolean @default(false) // If true, the self service users can see custody of assets inside the organization
  selfServiceCanSeeBookings Boolean @default(false) // If true, the self service users can see bookings that are not theirs
  baseUserCanSeeCustody     Boolean @default(false) // If true, the base users can see the custody of assets inside the organization
  baseUserCanSeeBookings    Boolean @default(false) // If true, the base users can see the bookings that are not theirs

  // Barcode add-on (per-organization, managed via Stripe subscription)
  barcodesEnabled   Boolean   @default(false) // If true, this organization can use barcode functionality
  barcodesEnabledAt DateTime? // Track when barcode feature was enabled
  usedBarcodeTrial  Boolean   @default(false) // Set once a 7-day free barcode trial is activated (prevents reuse)

  // Audit add-on (per-organization, managed via Stripe subscription)
  auditsEnabled    Boolean   @default(false) // If true, this organization can use audit functionality
  auditsEnabledAt  DateTime? // Track when audit feature was enabled
  usedAuditTrial   Boolean   @default(false) // Set once a 7-day free audit trial is activated (prevents reuse)

  // This is used to disable the workspace for the user. It is set to true when the user leaves the workspace
  workspaceDisabled Boolean @default(false) // If true, the workspace is disabled and the user cannot access it

  locations         Location[]
  categories        Category[]
  qrCodes           Qr[]
  barcodes          Barcode[]
  invites           Invite[]
  userOrganizations UserOrganization[]

  createdAt          DateTime             @default(now())
  updatedAt          DateTime             @updatedAt
  customFields       CustomField[]
  images             Image[]              @relation("owner")
  assetModels        AssetModel[]
  assetIndexSettings AssetIndexSettings[]
  assetReminders     AssetReminder[]
  assetFilterPresets AssetFilterPreset[]

  auditSessions      AuditSession[]
  auditImages        AuditImage[]

  usersWithLastSelected User[] @relation("lastSelectedOrg")
  /// EPDA: API keys scoped to this workspace (see `model ApiKey`)
  apiKeys             ApiKey[]
  /// EPDA: goods receipts booked into this workspace (مذكرة/محضر استلام)
  goodsReceipts       GoodsReceipt[]
  roleChangeLogs      RoleChangeLog[]
  teamMemberNotes     TeamMemberNote[]
  activityEvents      ActivityEvent[]

  // Migration flag to track if sequential IDs have been generated for this organization's existing assets
  hasSequentialIdsMigrated Boolean @default(false)

  // QR code display preference - which ID to show on QR code labels
  qrIdDisplayPreference QrIdDisplayPreference @default(QR_ID)

  // Branding preference for downloadable labels
  showShelfBranding Boolean @default(true)

  // Custom footer text appended to workspace emails
  customEmailFooter String? @db.VarChar(500)

  // Indexes for foreign keys
  @@index([userId])
  @@index([ssoDetailsId])
}

model UserOrganization {
  id String @id @default(cuid())

  user           User         @relation(fields: [userId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  userId         String
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String

  roles     OrganizationRoles[]
  createdAt DateTime            @default(now())
  updatedAt DateTime            @updatedAt

  /// Secret, unguessable token for this member's iCal calendar-feed subscription
  /// in this workspace. Null until the user generates a feed; regenerating it
  /// rotates the value (invalidating any previously-shared subscription URL).
  /// `@unique` doubles as the lookup index for the public feed route.
  calendarTokenId String? @unique

  /// EPDA: the department this member works for, when they hold `DEPARTMENT`.
  ///
  /// This — not the role — is what scopes a department user's inventory: they
  /// see the assets whose custody sits with this `TeamMember`. The role only
  /// says "may act as a department"; the pointer says "which one". Keeping them
  /// separate is what lets a third department exist without touching code.
  ///
  /// `SetNull` on delete so removing a department row does not delete the
  /// people who worked in it.
  department   TeamMember? @relation("UserOrganizationDepartment", fields: [departmentTeamMemberId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  departmentTeamMemberId String?

  @@unique([userId, organizationId])
  // Index for foreign key
  @@index([organizationId])
  @@index([departmentTeamMemberId])
}

enum OrganizationType {
  PERSONAL
  TEAM
}

enum QrIdDisplayPreference {
  QR_ID // Display the QR code ID (current default)
  SAM_ID // Display the sequential/SAM ID
  // Barcode types (require Organization.barcodesEnabled). The asset's barcode of this
  // type takes precedence; if none, resolver falls back to QR_ID.
  Code128
  Code39
  DataMatrix
  ExternalQR
  EAN13
}

/// Organization-level roles.
///
/// EPDA deployment adds three operational roles on top of the upstream four:
///   - WAREHOUSE  (المستودعات) — creates/audits assets, approves & hands over requests
///   - FINANCE    (المالية)    — adds financial coding + depreciation, financial analytics
///   - INVENTORY  (المخزون)    — organization-wide oversight, may delete assets
///
/// IMPORTANT: adding a value here is not enough. Every new role MUST be
/// explicitly listed in BOTH:
///   1. `Role2PermissionMap` — apps/webapp/app/utils/permissions/permission.data.ts
///   2. `ROLES_WITH_ORG_WIDE_VISIBILITY` — apps/webapp/app/utils/permissions/role-scope.ts
/// Roles absent from (2) are scoped to their own records, which is the safe default.
///
/// @see {@link file://./../../../apps/docs/epda-workflow-and-roles.md}
enum OrganizationRoles {
  ADMIN
  BASE
  OWNER
  SELF_SERVICE
  WAREHOUSE
  FINANCE
  INVENTORY
  /// EPDA: an administrative department that receives stock from the warehouse
  /// in bulk and hands it on to its own staff (المرافق today; IT runs on OWNER
  /// because they are the workspace's system administrators).
  ///
  /// Deliberately generic rather than `FACILITIES`: which departments exist is
  /// data (`TeamMember.isDepartment`), so a third one is a row plus a user
  /// assignment — no enum value, no migration, no permission-map edit.
  DEPARTMENT
}

model SsoDetails {
  id String @id @default(cuid())

  // The domains of the organization. Comma separated for multiple domains
  domain String

  organizations Organization[]

  baseUserGroupId    String? // The group id for BASE users
  selfServiceGroupId String? // The group id for SELF_SERVICE users
  adminGroupId       String? // The group id for ADMIN users

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// Tier Ids are used to identify tiers (products) in Stripe. They must be predictable in our model.
// Each product in stripe has a metadata value called `shelf_tier` which holds the value of the enum
// Add more tiers if needed
enum TierId {
  free
  tier_1
  tier_2
  custom
}

// Tiers correspond to Stripe products
model Tier {
  id          TierId     @id // Used to create Stripe product ID
  name        String // Name coming from Stripe product
  subscribers User[]
  tierLimitId TierId?    @unique
  tierLimit   TierLimit? @relation(fields: [tierLimitId], references: [id])
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt
}

// TierLimit is used for the basic tiers
model TierLimit {
  id                   TierId   @id
  tier                 Tier?
  canImportAssets      Boolean  @default(false)
  canExportAssets      Boolean  @default(false)
  canImportNRM         Boolean  @default(false)
  canHideShelfBranding Boolean  @default(false)
  maxCustomFields      Int      @default(0)
  maxOrganizations     Int      @default(1)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

// CustomTierLimit is used for users which has Tier with ID: custom
model CustomTierLimit {
  id                   String   @id @default(cuid())
  user                 User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  userId               String?  @unique // This is the foreign key
  canImportAssets      Boolean  @default(true)
  canExportAssets      Boolean  @default(true)
  canImportNRM         Boolean  @default(true)
  canHideShelfBranding Boolean  @default(true)
  maxCustomFields      Int      @default(1000)
  maxOrganizations     Int      @default(1)
  isEnterprise         Boolean  @default(false) // Set this to true for enterprise users. It is used to control some visuals in the app
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model CustomField {
  id       String  @id @default(cuid())
  name     String
  helpText String?
  required Boolean @default(false)
  active   Boolean @default(true)

  type    CustomFieldType @default(TEXT)
  options String[]

  // Relationships
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String

  createdBy User   @relation(fields: [userId], references: [id], onUpdate: Cascade)
  userId    String

  categories Category[]

  // Datetime
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt
  deletedAt               DateTime?
  assetCustomFieldsValues AssetCustomFieldValue[]

  //@@unique([lower(name), organizationId]) //prisma doesnt support case insensitive unique index yet
  // Indexes for foreign keys
  @@index([organizationId])
  @@index([userId])
  @@index([organizationId, deletedAt])
}

enum CustomFieldType {
  TEXT
  OPTION
  BOOLEAN
  DATE
  MULTILINE_TEXT
  AMOUNT
  NUMBER
}

model AssetCustomFieldValue {
  id String @id @default(cuid())

  // value String
  value Json //{raw: "actual data",valueText:"text type",valueBoolean:"boolean type" and so on... }

  // Relationships
  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String

  customField   CustomField @relation(fields: [customFieldId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  customFieldId String

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([assetId, customFieldId], name: "AssetCustomFieldValue_lookup_idx")
  // Index for foreign key
  @@index([customFieldId])
}

// ISO 4217 Currency Codes
// See app/utils/currency.ts for the canonical list with full metadata
// Sorted alphabetically by currency code
enum Currency {
  AED // UAE Dirham
  AFN // Afghani
  ALL // Lek
  AMD // Armenian Dram
  ANG // Netherlands Antillean Guilder
  AOA // Kwanza
  ARS // Argentine Peso
  AUD // Australian Dollar
  AWG // Aruban Florin
  AZN // Azerbaijan Manat
  BAM // Convertible Mark
  BBD // Barbados Dollar
  BDT // Taka
  BGN // Bulgarian Lev
  BHD // Bahraini Dinar
  BIF // Burundi Franc
  BMD // Bermudian Dollar
  BND // Brunei Dollar
  BOB // Boliviano
