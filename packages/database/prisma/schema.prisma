/// EPDA: which official intake form a receipt is.
///
/// The authority uses two paper forms and warehouse staff pick per delivery.
/// They are not versions of one another — they carry different reference
/// fields, different totals, and different signatories — so the type is stored
/// and drives which fields the form collects and validates.
enum GoodsReceiptType {
  /// مذكرة استلام (نموذج رقم 2) — four document references (أمر الشراء،
  /// وثيقة الشحن، المعاينة، إشعار استلام مؤقت) and a three-line total that
  /// separates VAT.
  MEMO
  /// محضر استلام (نموذج رقم 3) — two references (طلب الشراء/التعميد، مستند)
  /// and a single VAT-inclusive total.
  RECORD
}

/// EPDA: where a receipt sits between being filled in and being fully signed.
///
/// Items are created at `SAVED`, **not** at `SIGNED`: the warehouse needs the
/// stock visible the moment it is booked in, and the created items land at
/// `AssetLifecycleStage.PENDING` where they are invisible to employees anyway.
/// The signatures gate the *approval* to `READY`, not the data entry — see
/// `assertReceiptSignedBeforeApproval`.
enum GoodsReceiptState {
  /// Being filled in. No items exist yet.
  DRAFT
  /// Submitted — items created at PENDING. Awaiting the three signatures.
  SAVED
  /// All three parties signed. Its items may now be approved to READY.
  SIGNED
  /// Cancelled. Kept, not deleted, so a voided receipt stays in the record.
  VOIDED
}

/// EPDA: the three signatory roles on each form.
///
/// Both forms take exactly three signatures but name them differently, so the
/// enum carries all six rather than three generic slots. Naming them by their
/// actual job title is what makes a printed محضر match the paper one, and what
/// lets the UI label each box correctly without a lookup table keyed on type.
enum GoodsReceiptParty {
  // ── نموذج رقم 2 (مذكرة استلام) ──
  /// مأمور عهدة ساحة الاستلام (المسلم)
  YARD_CUSTODIAN
  /// أمين المستودع / مأمور العهدة (المستلم)
  WAREHOUSE_KEEPER
  /// رئيس قسم المستودعات
  WAREHOUSE_HEAD

  // ── نموذج رقم 3 (محضر استلام) ──
  /// المستلم
  RECEIVER
  /// العضو الفني
  TECHNICAL_MEMBER
  /// الرئيس المسؤول
  RESPONSIBLE_HEAD
}

/// EPDA: whether a receipt line becomes individually tracked items or one
/// quantity-tracked row.
///
/// Chosen per line by the warehouse operator. Ten laptops need ten rows, each
/// with its own QR and serial; five hundred pens need one row with a quantity.
/// Forcing either rule on every line would make one of those two cases
/// unusable.
enum GoodsReceiptLineTracking {
  /// One record per unit — `quantity` rows of `AssetType.INDIVIDUAL`.
  INDIVIDUAL
  /// One record holding the whole quantity — `AssetType.QUANTITY_TRACKED`.
  BULK
}

/// EPDA: أصل (durable asset) vs مادة (consumable material).
///
/// **Not yet derived from anything.** The authority's classification rules are
/// still being written; until they arrive the column stays null and
/// `classifyReceiptLine` returns null. It exists now so the receipt flow writes
/// the field from day one and no backfill is needed later.
///
/// Deliberately separate from `AssetType`, which answers a different question:
/// `AssetType` is *how we track it* (one row or a counted pool), `ItemClass` is
/// *what it is* for accounting. A أصل can be quantity-tracked and a مادة can be
/// individually tracked; collapsing them would make one of those unrepresentable.
enum ItemClass {
  /// أصل — durable, capitalised, depreciated.
  ASSET
  /// مادة — consumable, expensed on issue.
  MATERIAL
}

/// EPDA: the kind of thing being received, which decides its capitalisation
/// threshold.
///
/// The authority sets a different threshold per category — a vehicle is
/// capitalised above 10,000 SAR, a desk above 1,000 — so this is *not* cosmetic
/// grouping: it is the input that decides whether an item becomes a أصل or a
/// مادة. The warehouse operator picks it per line when booking a delivery in.
///
/// Deliberately a fixed enum rather than the existing free-form `Category`
/// table: `Category` is workspace-editable labelling, and letting an operator
/// invent a category would mean inventing a threshold with it — silently
/// deciding an accounting rule. The thresholds live in
/// `app/modules/goods-receipt/capitalization.ts`.
enum ItemCategory {
  /// أثاث ومفروشات
  FURNITURE
  /// مركبات
  VEHICLES
  /// أجهزة مكتبية
  OFFICE_EQUIPMENT
  /// أجهزة تقنية
  IT_EQUIPMENT
  /// أجهزة وتقنيات أخرى
  OTHER_EQUIPMENT
}

/// EPDA: an official goods-receipt document (مذكرة/محضر استلام).
///
/// This is now the **only** way stock enters the system. `/assets/new` and the
/// CSV importer are closed behind `asset.import`, because an item with no
/// supplier, no purchase-order reference and no value is exactly the record the
/// paper forms exist to prevent.
///
/// One receipt carries many lines; each line becomes one or more `Asset` rows
/// when the receipt is saved. The link is kept (`GoodsReceiptLine.assets`) so
/// any item can be traced back to the document that admitted it.
///
/// @see {@link file://./../../../apps/webapp/app/modules/goods-receipt/service.server.ts}
model GoodsReceipt {
  id String @id @default(cuid())

  type  GoodsReceiptType
  state GoodsReceiptState @default(DRAFT)

  /// رقم التسلسل — workspace-scoped running number (e.g. "EPDA-RCV-2026-0042").
  /// Stored rather than derived so a reprint always carries the number that was
  /// signed on paper.
  reference String

  /// السنة المالية. Free text, not a date: the authority writes it as "1447"
  /// or "2026" depending on the calendar in use, and normalising it would be
  /// this system deciding something it has no business deciding.
  fiscalYear String?

  // ── ترويسة النموذج ──
  /// الجهة
  entityName String?
  /// رقم الجهة
  entityNumber String?
  /// مستودع
  warehouseName String?
  /// عدد الصفحات
  pageCount Int?
  /// تاريخ الاستلام (نموذج 2) / التاريخ (نموذج 3)
  receiptDate DateTime? @db.Timestamptz(3)

  /// المورد — free text. Suppliers are not an entity in this system yet, and
  /// inventing one to satisfy a text box on a form would be the tail wagging
  /// the dog.
  supplier String?

  // ── مراجع نموذج 2 (مذكرة استلام) ──
  /// أمر الشراء
  purchaseOrderNumber String?
  purchaseOrderDate   DateTime? @db.Timestamptz(3)
  /// وثيقة الشحن
  shippingDocNumber String?
  shippingDocDate   DateTime? @db.Timestamptz(3)
  /// المعاينة — رقم المحضر
  inspectionRecordNumber String?
  inspectionRecordDate   DateTime? @db.Timestamptz(3)
  /// إشعار استلام مؤقت
  provisionalNoticeNumber String?
  provisionalNoticeDate   DateTime? @db.Timestamptz(3)

  // ── مراجع نموذج 3 (محضر استلام) ──
  /// رقم طلب الشراء / التعميد
  purchaseRequestNumber String?
  /// مستند — its name, number and date
  supportingDocName   String?
  supportingDocNumber String?
  supportingDocDate   DateTime? @db.Timestamptz(3)

  // ── المجاميع ──
  //
  // Stored as integer halalas, never as a float. A receipt is an accounting
  // document; `0.1 + 0.2` must not be able to make its total disagree with the
  // paper it was copied from. The ريال/هللة columns on the form are two views
  // of one integer (see `utils/money.ts`).
  //
  // Recomputed from the lines on every save rather than trusted from the
  // client — the totals row is the part of the form most worth tampering with.
  /// القيمة الاجمالية (نموذج 2) — subtotal before VAT.
  subtotalHalalas Int @default(0)
  /// مجموع ضريبة القيمة المضافة (نموذج 2 only; 0 on نموذج 3).
  vatHalalas Int @default(0)
  /// اجمالي المبلغ (نموذج 2) / القيمة الاجمالية شامل الضريبة (نموذج 3).
  totalHalalas Int @default(0)

  lines      GoodsReceiptLine[]
  signatures GoodsReceiptSignature[]

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  /// The warehouse operator who filled the form in. `SetNull` — the document
  /// must outlive the staff account that produced it.
  createdBy   User?   @relation("goodsReceiptCreatedBy", fields: [createdById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  createdById String?

  /// When the form was submitted and its items created. Null while `DRAFT`.
  savedAt DateTime? @db.Timestamptz(3)
  /// When the third signature landed. Null until `SIGNED`.
  signedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  /// The running number is unique per workspace, not globally — two authorities
  /// on one instance each start at 1.
  @@unique([organizationId, reference], name: "goods_receipt_reference_unique")
  @@index([organizationId, state])
  @@index([createdById])
}

/// EPDA: one row of a receipt's item table.
///
/// Holds what the operator typed. The `Asset` rows it produces are derived from
/// it, which is why both survive independently: correcting a typo on an asset
/// must not silently rewrite the signed document, and vice versa.
model GoodsReceiptLine {
  id String @id @default(cuid())

  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiptId String

  /// الرقم — position in the printed table, 1-based.
  lineNumber Int

  /// رقم الصنف التسلسلي (نموذج 2) / رقم التصنيف التسلسلي (نموذج 3).
  /// The supplier's or the authority's own coding, as written on the form —
  /// distinct from `Asset.sequentialId`, which this system generates itself.
  itemCode String?

  /// اسم الصنف
  name String
  /// ووصفه — نموذج 2 prints name and description in one column; نموذج 3 has no
  /// description field at all. Nullable so نموذج 3 simply leaves it unset.
  description String?

  /// الوحدة — e.g. "حبة", "علبة", "متر".
  unit String?
  /// الكمية
  quantity Int

  /// سعر الوحدة, in halalas. See the totals note on `GoodsReceipt`.
  unitPriceHalalas Int @default(0)
  /// مجموع القيمة = quantity × unitPriceHalalas, recomputed server-side.
  lineTotalHalalas Int @default(0)

  /// ملاحظات
  notes String?

  /// Whether this line becomes N individual records or one counted row.
  tracking GoodsReceiptLineTracking @default(INDIVIDUAL)

  /// أصل / مادة. Null until the authority's rules are implemented — see
  /// `enum ItemClass`.
  itemClass ItemClass?

  /// نوع الصنف — chosen by the operator, and the input that decides
  /// `itemClass` via the category's capitalisation threshold.
  ///
  /// Nullable because lines booked in before categories existed have none, and
  /// backfilling them would mean guessing an accounting classification. Those
  /// lines keep `itemClass = null` and can be classified once someone says what
  /// they were.
  itemCategory ItemCategory?

  /// The items this line produced. Cascade is deliberately NOT set: deleting a
  /// receipt line must not delete stock that physically exists.
  assets Asset[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([receiptId, lineNumber], name: "goods_receipt_line_number_unique")
  @@index([receiptId])
}

/// EPDA: one of the three signatures on a receipt.
///
/// Mirrors `CustodyHandoverSignature` deliberately — same snapshotting of the
/// declared name, same private-bucket image path, same evidentiary IP/UA. Two
/// different signature models in one system would drift; this one stays a
/// recognisable twin so a reader who understands one understands both.
model GoodsReceiptSignature {
  id String @id @default(cuid())

  receipt   GoodsReceipt @relation(fields: [receiptId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  receiptId String

  party GoodsReceiptParty

  /// Signing user, when the party has an account. `SetNull` — the signature
  /// outlives the account.
  signedByUser   User?   @relation("goodsReceiptSignatory", fields: [signedByUserId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  signedByUserId String?

  /// Name as typed at signing time. Snapshotted: the document must keep reading
  /// the name that was agreed to even after the person renames or leaves.
  declaredName String

  /// Path of the PNG inside the private `goods-receipt-signatures` bucket.
  /// Never a public URL — signature images are personal data.
  signatureImagePath String

  ipAddress String?
  userAgent String?

  signedAt DateTime @default(now())

  /// One signature per party per receipt — re-signing replaces, never appends.
  @@unique([receiptId, party], name: "goods_receipt_signature_party_unique")
  @@index([signedByUserId])
}

/// EPDA: instance-wide configuration, stored as key → value.
///
/// Deliberately NOT organization-scoped. The settings kept here — which
/// authentication method is live, the SAML/OIDC/LDAP connection details — are
/// resolved on the login screen, *before* any organization context exists.
/// Scoping them per workspace would make them unreadable at the moment they
/// are needed.
///
/// Rows are created lazily: a key that has never been written simply does not
/// exist, and the reader falls back to the registry default in
/// `app/modules/app-settings/registry.ts`. That registry — not this table — is
/// the list of settings the system knows about; an unrecognised row is ignored
/// rather than trusted.
///
/// Only app-wide admins (`Roles.ADMIN`, تقنية المعلومات) may read or write
/// this table through the application.
model AppSetting {
  /// Registry key, e.g. `auth.method` or `auth.saml.certificate`.
  key String @id

  /// Plaintext for ordinary settings; an AES-256-GCM envelope produced by
  /// `encryptSecret()` when `isSecret` is true. Null means "explicitly cleared"
  /// and still falls back to the registry default.
  value String? @db.Text

  /// Whether `value` holds ciphertext. Stored rather than derived from the
  /// registry so a key that changes classification later can still be decrypted
  /// (or read) according to how it was actually written.
  isSecret Boolean @default(false)

  /// Registry category (`auth`, `saml`, `oidc`, `ldap`, `general`). Duplicated
  /// from the registry so the settings API can group rows without loading it.
  category String

  /// Who last wrote this key. Kept as SetNull so deleting an admin account
  /// never destroys the settings they touched.
  updatedBy   User?   @relation("appSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  updatedById String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([category])
  @@index([updatedById])
}

/// EPDA: a credential issued to an external system so it can call `/api/v1/*`.
///
/// The token itself is never stored. `hashedKey` holds its SHA-256 digest and
/// `prefix` holds the first characters, which is what the UI shows so an admin
/// can recognise a key in the list after the one-time reveal at creation.
///
/// Keys are organization-scoped: every service function behind the external API
/// takes an `organizationId`, so binding the credential to one workspace is what
/// makes the API safe to expose at all. Issuing and revoking, however, is
/// restricted to app-wide admins.
model ApiKey {
  id String @id @default(cuid())

  /// Human label chosen by the admin, e.g. "ERP nightly sync".
  name String

  /// Leading segment of the token (`epda_` + 8 chars). Unique so it can be used
  /// as a stable display handle; it is NOT sufficient to authenticate.
  prefix String @unique

  /// SHA-256 hex digest of the full token. Looked up directly on every request,
  /// which is why it is unique and indexed.
  hashedKey String @unique

  /// Capability list checked by `requireApiKey`. Values come from
  /// `API_KEY_SCOPES` — an unknown scope grants nothing.
  scopes String[]

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  /// The admin who issued the key. Cascade-safe: keys outlive nothing.
  createdBy   User   @relation("apiKeyCreatedBy", fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String

  /// Best-effort usage stamp, written at most once a minute (see
  /// `touchApiKeyUsage`) so a busy integration does not write on every call.
  lastUsedAt DateTime? @db.Timestamptz(3)

  /// Optional hard expiry. A key past this instant fails authentication.
  expiresAt DateTime? @db.Timestamptz(3)

  /// Revocation is a soft delete: the row stays so the audit trail — who issued
  /// what, when it was last used — survives the revocation.
  revokedAt DateTime? @db.Timestamptz(3)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId])
  @@index([createdById])
}

/// EPDA: where a booking sits in the المستودعات approval queue.
///
/// Deliberately separate from `BookingStatus`, which tracks the *lifecycle* of
/// an approved booking (draft → reserved → ongoing → complete). A booking can
/// be DRAFT and APPROVED, or DRAFT and PENDING — they answer different
/// questions.
enum BookingApprovalState {
  /// Raised by an employee, waiting on المستودعات. Cannot be reserved.
  PENDING
  /// Accepted — behaves like any pre-EPDA booking.
  APPROVED
  /// Turned down with a reason. Kept rather than deleted so the employee can
  /// see what happened and the decision stays auditable.
  REJECTED
}

enum BookingStatus {
  DRAFT
  RESERVED
  ONGOING
  OVERDUE
  COMPLETE
  ARCHIVED
  CANCELLED
}

/**
 * Audit trail for all quantity changes on quantity-tracked assets.
 * Every event records who performed it, who received/returned items,
 * which booking it relates to, and the category of change.
 * Quantity is always positive — direction is determined by category.
 */
model ConsumptionLog {
  id        String              @id @default(cuid())
  asset     Asset               @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId   String
  category  ConsumptionCategory
  quantity  Int // Always positive. Direction determined by category (Decision #9).
  note      String?

  performedBy User   @relation(fields: [userId], references: [id])
  userId      String

  custodian   TeamMember? @relation(fields: [custodianId], references: [id])
  custodianId String? // Who received/returned the items (if applicable)

  // Datetime
  createdAt DateTime @default(now())

  @@index([assetId, createdAt])
  @@index([userId])
  @@index([custodianId])
}







model AssetLocation {
  id             String       @id @default(cuid())
  asset          Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId        String
  location       Location     @relation(fields: [locationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  locationId     String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  quantity       Int          @default(1)

  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  // The "INDIVIDUAL asset at one location" cap is enforced by the
  // `enforce_individual_asset_single_location` trigger; the
  // `sum(quantity) <= Asset.quantity` invariant by the deferred
  // `enforce_asset_location_sum_within_total` constraint trigger.
  //
  // Every placement is manual now that kits are gone, so (asset, location)
  // is unique outright — the drop migration collapses the two partial uniques
  // (manual / kit-driven) into this one. `map:` pins the DB index name — see
  // the same note on `Custody`.
  @@unique([assetId, locationId], name: "AssetLocation_manual_unique", map: "AssetLocation_manual_unique")
  @@index([locationId])
  @@index([organizationId])
  @@index([assetId])
}

model AssetReminder {
  id                       String       @id @default(cuid())
  name                     String
  message                  String
  alertDateTime            DateTime
  activeSchedulerReference String?
  organization             Organization @relation(fields: [organizationId], references: [id])
  organizationId           String
  asset                    Asset        @relation(fields: [assetId], references: [id], onDelete: Cascade)
  assetId                  String
  teamMembers              TeamMember[]
  createdBy                User         @relation(fields: [createdById], references: [id])
  createdById              String
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  // Optimized indexes
  @@index([assetId, alertDateTime])
  // Keeping these indexes as they were added for a purpose
  @@index([name(ops: raw("gin_trgm_ops")), message(ops: raw("gin_trgm_ops"))], type: Gin)
  @@index([organizationId, alertDateTime, assetId])
  // For scheduler related queries
  @@index([alertDateTime, activeSchedulerReference])
  // Index for foreign key
  @@index([createdById])
}

model WorkingHours {
  id String @id @default(cuid())

  // Global enable/disable for the organization
  enabled Boolean @default(false)

  // Weekly schedule stored as JSON for better performance
  // Format: { "0": { "isOpen": true, "openTime": "09:00", "closeTime": "17:00" }, ... }
  // Keys are day numbers (0=Sunday, 1=Monday, etc.)
  // Times are wall-clock "HH:MM" (24-hour) — no timezone conversion. These
  // describe when the physical location is open, so they are interpreted as
  // local wall time, not UTC.
  weeklySchedule Json @default("{\"0\":{\"isOpen\":false},\"1\":{\"isOpen\":true,\"openTime\":\"09:00\",\"closeTime\":\"17:00\"},\"2\":{\"isOpen\":true,\"openTime\":\"09:00\",\"closeTime\":\"17:00\"},\"3\":{\"isOpen\":true,\"openTime\":\"09:00\",\"closeTime\":\"17:00\"},\"4\":{\"isOpen\":true,\"openTime\":\"09:00\",\"closeTime\":\"17:00\"},\"5\":{\"isOpen\":true,\"openTime\":\"09:00\",\"closeTime\":\"17:00\"},\"6\":{\"isOpen\":false}}")

  // Relationships
  organization   Organization @relation(fields: [organizationId], references: [id], onUpdate: Cascade, onDelete: Cascade)
  organizationId String       @unique

  // Only overrides need separate table for better querying
  overrides WorkingHoursOverride[]

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Index for foreign key
  @@index([organizationId])
}

// Keep overrides separate for efficient date-based queries
model WorkingHoursOverride {
  id String @id @default(cuid())

  date   DateTime @db.Date
  isOpen Boolean  @default(false)

  // Wall-clock "HH:MM" (24-hour) — no timezone conversion (see WorkingHours).
  openTime  String? // Format: "09:00"
  closeTime String? // Format: "17:00"
  reason    String?

  workingHours   WorkingHours @relation(fields: [workingHoursId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  workingHoursId String

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workingHoursId, date])
  @@index([workingHoursId, date])
  @@index([date, isOpen])
}

enum UpdateStatus {
  DRAFT
  PUBLISHED
}

model Update {
  id String @id @default(cuid())

  title       String
  content     String // Markdown content
  url         String? // Optional URL to redirect to when clicked
  imageUrl    String? // Optional featured image URL (external hosting)
  publishDate DateTime // When the update should be visible to users
  status      UpdateStatus @default(DRAFT)

  // Role targeting - if null, visible to all roles
  targetRoles OrganizationRoles[]

  // Analytics
  clickCount Int @default(0)
  viewCount  Int @default(0)

  // Relations
  userReads UserUpdateRead[]

  // Creator tracking
  createdBy   User   @relation(fields: [createdById], references: [id], onDelete: Cascade, onUpdate: Cascade)
  createdById String

  // Timestamps
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([status, publishDate])
  @@index([publishDate])
  @@index([createdById])
}

model UserUpdateRead {
  id String @id @default(cuid())

  // Relations
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  update   Update @relation(fields: [updateId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  updateId String

  // Track when it was read
  readAt DateTime @default(now())

  @@unique([userId, updateId])
  @@index([userId])
  @@index([updateId])
  @@index([readAt])
}

enum AuditStatus {
  PENDING
  ACTIVE
  COMPLETED
  CANCELLED
  ARCHIVED
}

enum AuditAssetStatus {
  PENDING
  FOUND
  MISSING
  UNEXPECTED
}

enum AuditAssignmentRole {
  LEAD
  PARTICIPANT
}

model AuditNote {
  id      String   @id @default(cuid())
  content String
  type    NoteType @default(COMMENT)

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  user           User?        @relation("AuditNoteUser", fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  userId         String?
  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auditSessionId String

  // Optional link to specific asset within the audit
  auditAsset   AuditAsset? @relation(fields: [auditAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditAssetId String?

  // Indexes for foreign keys
  @@index([auditSessionId])
  @@index([userId])
  @@index([auditAssetId])
}

model TeamMemberNote {
  id      String   @id @default(cuid())
  content String
  type    NoteType @default(COMMENT)

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relationships
  // The admin who wrote the note
  user   User?   @relation("TeamMemberNoteAuthor", fields: [userId], references: [id], onUpdate: Cascade, onDelete: SetNull)
  userId String?

  // The team member the note is about (workspace-scoped identity)
  teamMember   TeamMember @relation(fields: [teamMemberId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  teamMemberId String

  // Workspace scoping — notes in Workspace A are invisible in Workspace B
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  // Indexes for foreign keys and common queries
  @@index([teamMemberId])
  @@index([userId])
  @@index([organizationId])
  @@index([teamMemberId, organizationId])
}

model AuditSession {
  id String @id @default(cuid())

  name        String
  description String?

  targetId  String?
  status    AuditStatus @default(PENDING)
  scopeMeta Json?

  expectedAssetCount   Int @default(0)
  foundAssetCount      Int @default(0)
  missingAssetCount    Int @default(0)
  unexpectedAssetCount Int @default(0)

  startedAt   DateTime?
  dueDate     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?
  activeSchedulerReference String?

  createdBy      User         @relation(fields: [createdById], references: [id])
  createdById    String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  assignments AuditAssignment[]
  assets      AuditAsset[]
  scans       AuditScan[]
  notes       AuditNote[]
  images      AuditImage[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([organizationId, status])
  @@index([createdById])
  @@index([status, createdAt])
}

model AuditAssignment {
  id String @id @default(cuid())

  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auditSessionId String

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  userId String

  role AuditAssignmentRole?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([auditSessionId, userId])
  @@index([userId])
}

model AuditAsset {
  id String @id @default(cuid())

  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auditSessionId String

  asset   Asset  @relation(fields: [assetId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  assetId String

  expected Boolean          @default(true)
  status   AuditAssetStatus @default(PENDING)

  scannedBy   User?   @relation(fields: [scannedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scannedById String?

  scannedAt DateTime?
  metadata  Json?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  scans AuditScan[]
  images AuditImage[]
  notes AuditNote[]

  @@unique([auditSessionId, assetId])
  @@index([status])
  @@index([scannedById])
}

model AuditScan {
  id String @id @default(cuid())

  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auditSessionId String

  auditAsset   AuditAsset? @relation(fields: [auditAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditAssetId String?

  asset   Asset?  @relation(fields: [assetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  assetId String?

  scannedBy   User?   @relation(fields: [scannedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  scannedById String?

  code String?

  metadata Json?

  scannedAt DateTime @default(now())
  createdAt DateTime @default(now())

  @@index([auditSessionId, scannedAt])
  @@index([auditAssetId])
  @@index([assetId])
}

model AuditImage {
  id String @id @default(cuid())

  imageUrl     String
  thumbnailUrl String?
  description  String?

  // Relationships
  auditSession   AuditSession @relation(fields: [auditSessionId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  auditSessionId String

  // Optional link to specific asset within the audit
  auditAsset   AuditAsset? @relation(fields: [auditAssetId], references: [id], onDelete: SetNull, onUpdate: Cascade)
  auditAssetId String?

  uploadedBy   User?   @relation("AuditImageUploader", fields: [uploadedById], references: [id], onDelete: SetNull, onUpdate: Cascade)
  uploadedById String?

  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)
  organizationId String

  // Datetime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Indexes for performance
  @@index([auditSessionId])
  @@index([auditAssetId])
  @@index([organizationId])
  @@index([uploadedById])
}

model RoleChangeLog {
  id           String            @id @default(cuid())
  previousRole OrganizationRoles
  newRole      OrganizationRoles
  createdAt    DateTime          @default(now())

  // Who was changed
  user   User   @relation("roleChangeTarget", fields: [userId], references: [id])
  userId String

  // Who performed the change
  changedBy   User   @relation("roleChangeActor", fields: [changedById], references: [id])
  changedById String

  // Which organization
  organization   Organization @relation(fields: [organizationId], references: [id])
  organizationId String

  @@index([userId, organizationId])
  @@index([organizationId, createdAt])
}

// Structured, append-only stream of state-change events.
// Written in parallel with the legacy system-notes (`type = UPDATE`) so the
// existing activity-feed UI keeps working unchanged; reports read only from
// this table. See `.claude/rules/use-record-event.md` for usage rules.
model ActivityEvent {
  id             String   @id @default(cuid())
  organizationId String
  occurredAt     DateTime @default(now()) @db.Timestamptz(3)

  // Who
  actorUserId   String?
  // Snapshot of the actor at write time — robust against user deletion / rename
  // for historical reports. Shape: { firstName, lastName, displayName }.
  actorSnapshot Json?

  // What
  action     ActivityAction
  entityType ActivityEntity
  entityId   String

  // Sparse cross-refs — populate whichever apply to the event. Plain FKs (no
  // relation blocks) keep this table independent of source-entity cascade rules.
  assetId        String?
  bookingId      String?
  auditSessionId String?
  auditAssetId   String?
  locationId     String?
  teamMemberId   String?
  targetUserId   String?

  // Typed field-change payload — used by `*_CHANGED` actions.
  // One event per changed field; see `record-event-payload-shapes` rule.
  field     String?
  fromValue Json?
  toValue   Json?

  // Action-specific extras (e.g. { isExpected } for AUDIT_ASSET_SCANNED).
  meta Json?

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade, onUpdate: Cascade)

  // Reports-oriented indexes. Kept tight; expand only when a real report needs it.
  @@index([organizationId, occurredAt])
  @@index([organizationId, action, occurredAt])
  @@index([organizationId, entityType, entityId, occurredAt])
  @@index([actorUserId, occurredAt])
  @@index([assetId, occurredAt])
  @@index([bookingId, occurredAt])
  @@index([auditSessionId, occurredAt])
}

enum ActivityEntity {
  ASSET
  BOOKING
  AUDIT
  // Historical only — see ASSET_KIT_CHANGED.
  KIT
  LOCATION
  TEAM_MEMBER
  CUSTODY
  USER
  ORGANIZATION
}

// Additive-only. Never rename or remove values — query compatibility depends
// on historical events keeping their original action name.
enum ActivityAction {
  // Asset
  ASSET_CREATED
  ASSET_NAME_CHANGED
  ASSET_DESCRIPTION_CHANGED
  ASSET_CATEGORY_CHANGED
  // Historical only — kits were removed from the product. Postgres cannot drop
  // an enum value in place, and rewriting the audit trail to erase that a kit
  // change once happened is worse than an unused label. Nothing emits these.
  ASSET_KIT_CHANGED
  ASSET_LOCATION_CHANGED
  ASSET_TAGS_CHANGED
  ASSET_STATUS_CHANGED
  ASSET_VALUATION_CHANGED
  ASSET_CUSTOM_FIELD_CHANGED
  ASSET_PREFERRED_BARCODE_CHANGED
  ASSET_ARCHIVED
  ASSET_DELETED

  // Custody
  CUSTODY_ASSIGNED
  CUSTODY_RELEASED

  // Booking
  BOOKING_CREATED
  BOOKING_STATUS_CHANGED
  BOOKING_DATES_CHANGED
  BOOKING_ASSETS_ADDED
  BOOKING_ASSETS_REMOVED
  BOOKING_CHECKED_OUT
  BOOKING_CHECKED_IN
  BOOKING_PARTIAL_CHECKIN
  BOOKING_PARTIAL_CHECKOUT
  BOOKING_CANCELLED
  BOOKING_ARCHIVED

  // Audit
  AUDIT_CREATED
  AUDIT_STARTED
  AUDIT_ASSETS_ADDED
  AUDIT_ASSETS_REMOVED
  AUDIT_ASSET_SCANNED
  AUDIT_ASSET_SCAN_REMOVED
  AUDIT_DUE_DATE_CHANGED
  AUDIT_ASSIGNEE_ADDED
  AUDIT_ASSIGNEE_REMOVED
  AUDIT_UPDATED
  AUDIT_COMPLETED
  AUDIT_CANCELLED
  AUDIT_ARCHIVED

  // Location
  LOCATION_CREATED
  LOCATION_UPDATED

  // Organization (workspace-level configuration changes)
  ORGANIZATION_QR_ID_DISPLAY_PREFERENCE_CHANGED
}
